<%- include("partials/header", { title, navLinks, activePath }) %>

<main class="container py-4">
  <section class="panel hero-panel">
    <div>
      <h2>Habits that reduce risk</h2>
      <ul>
        <li>Check sender addresses and URLs before clicking.</li>
        <li>Pause when a message tries to create pressure or urgency.</li>
        <li>Verify unusual requests through a second communication channel.</li>
        <li>Report suspicious emails before other users interact with them.</li>
      </ul>
    </div>
    <img class="hero-image" src="/img/security-awareness-illustration.svg" alt="Security awareness illustration">
  </section>

  <section class="panel">
    <h2>Attachment Awareness</h2>
    <p class="section-note">
      These extension examples use package metadata from <code>mime-db</code>.
    </p>
    <div class="card-grid">
      <% riskyExtensions.forEach((item) => { %>
        <article class="data-card">
          <p class="card-label"><%= item.extension %></p>
          <h3><%= item.mimeType %></h3>
          <p><%= item.note %></p>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
